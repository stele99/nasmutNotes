# Siehe docs/URS.md, Kapitel 9 (Konfiguration)

APP_ENV=development
APP_URL=http://localhost:8080
APP_KEY=base64:CHANGE_ME_GENERATE_32_RANDOM_BYTES_BASE64
APP_DEBUG=true

DB_PATH=var/data/app.sqlite
UPLOAD_PATH=var/uploads

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback
GOOGLE_HOSTED_DOMAIN=

ADMIN_EMAILS=

INVITE_TTL_DAYS=7
SESSION_LIFETIME_DAYS=30
MAX_UPLOAD_MB=10
# Anfangswert des Standard-Speicherkontingents je Nutzer in MB (0 = unbegrenzt).
# Zur Laufzeit im Admin-Dashboard aenderbar; der dort gesetzte Wert hat Vorrang.
DEFAULT_STORAGE_QUOTA_MB=0
# Anfangswert der Obergrenze je Dateianhang in MB; im Admin-Dashboard aenderbar.
MAX_ATTACHMENT_MB=10
# Bis zu dieser Groesse (KB) laden Clients Anhaenge und Bilder automatisch fuer
# den Offline-Betrieb mit; groessere bleiben nur online erreichbar. 0 = keine.
# Im Admin-Dashboard aenderbar; der dort gesetzte Wert hat Vorrang.
OFFLINE_ATTACHMENT_MAX_KB=250
TRASH_RETENTION_DAYS=90
IMPORT_MAX_LINES=500
# Obergrenze fuer das ZIP-Archiv beim Notiz-Import in MB. Die Oberflaeche
# uebertraegt in Teilen, deshalb sind dafuer keine hohen PHP-Limits noetig; nur
# der Upload in einer Anfrage haengt an upload_max_filesize/post_max_size.
IMPORT_MAX_ARCHIVE_MB=500
# Ablage der Teile eines laufenden Uploads (ausserhalb des Web-Roots).
IMPORT_TMP_PATH=var/tmp/import
SEARCH_RESULT_LIMIT=20

RATE_LIMIT_ENABLED=true

# Ablage der Sicherungen; muss außerhalb des Web-Roots liegen.
BACKUP_PATH=var/backups
# Anzahl aufbewahrter Sicherungen. Unveränderte Dateien liegen nur einmal im
# Pool, ein zusätzlicher Lauf kostet deshalb kaum Platz.
BACKUP_KEEP=14

LOG_LEVEL=info

# Vite-Dev-Server (nur APP_ENV=development)
VITE_DEV_SERVER=http://localhost:5173
